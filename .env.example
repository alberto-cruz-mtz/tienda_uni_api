# Spring profile: "dev" (host-local), "docker" (compose), "prod" (real prod)
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL connection (consumed by application-{docker,prod}.yaml)
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tienda_uni

# JWT signing secret (consumed by application-{docker,prod}.yaml)
# Use a long random string, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=change-me
EMAIL_PASSWORD=change-me
EMAIL_SENDER=no-reply@example.com

# Frontend URLs (consumed by application-{docker,prod}.yaml)
FRONTEND_URL=http://localhost:3000
ERROR_URL=http://localhost:3000/errors

# AWS S3 (consumed by application-{docker,prod}.yaml)
# En docker el endpoint por defecto apunta a MinIO local (http://localhost:9000);
# en prod se omite el endpoint para usar el S3 real.
AWS_REGION=us-east-1
AWS_S3_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY=change-me
AWS_SECRET_KEY=change-me
AWS_S3_BUCKET_PROFILE_PICTURES=avatars
AWS_S3_BUCKET_POST_MEDIA=publication-media
