# Spring profile: "dev" (default, uses application.yaml) or "prod" (uses application-prod.yaml)
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL connection (consumed by application-prod.yaml)
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tienda_uni

# JWT signing secret (consumed by application-prod.yaml)
# Use a long random string, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me
